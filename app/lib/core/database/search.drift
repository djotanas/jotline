import 'tables/blocks.dart';
import 'tables/pages.dart';

CREATE VIRTUAL TABLE page_search USING fts5(
  title,
  body,
  tokenize = 'unicode61 remove_diacritics 2'
);

CREATE TRIGGER pages_search_ai AFTER INSERT ON pages BEGIN
  INSERT OR REPLACE INTO page_search (rowid, title, body)
  SELECT p.rowid, p.title,
    COALESCE((
      SELECT group_concat(t.text, char(8233))
      FROM (
        SELECT CASE WHEN json_valid(b.content_json) THEN CAST(json_extract(b.content_json, '$.text') AS TEXT) END AS text
        FROM blocks b
        WHERE b.page_id = p.id
          AND b.deleted_at IS NULL
          AND b.type IN ('text', 'heading', 'bulleted_list_item', 'checklist_item')
        ORDER BY b.position, b.id
      ) t
    ), '')
  FROM pages p
  WHERE p.id = new.id;
END;

CREATE TRIGGER pages_search_au AFTER UPDATE OF title ON pages BEGIN
  INSERT OR REPLACE INTO page_search (rowid, title, body)
  SELECT p.rowid, p.title,
    COALESCE((
      SELECT group_concat(t.text, char(8233))
      FROM (
        SELECT CASE WHEN json_valid(b.content_json) THEN CAST(json_extract(b.content_json, '$.text') AS TEXT) END AS text
        FROM blocks b
        WHERE b.page_id = p.id
          AND b.deleted_at IS NULL
          AND b.type IN ('text', 'heading', 'bulleted_list_item', 'checklist_item')
        ORDER BY b.position, b.id
      ) t
    ), '')
  FROM pages p
  WHERE p.id = new.id;
END;

CREATE TRIGGER blocks_search_ai AFTER INSERT ON blocks BEGIN
  INSERT OR REPLACE INTO page_search (rowid, title, body)
  SELECT p.rowid, p.title,
    COALESCE((
      SELECT group_concat(t.text, char(8233))
      FROM (
        SELECT CASE WHEN json_valid(b.content_json) THEN CAST(json_extract(b.content_json, '$.text') AS TEXT) END AS text
        FROM blocks b
        WHERE b.page_id = p.id
          AND b.deleted_at IS NULL
          AND b.type IN ('text', 'heading', 'bulleted_list_item', 'checklist_item')
        ORDER BY b.position, b.id
      ) t
    ), '')
  FROM pages p
  WHERE p.id = new.page_id;
END;

CREATE TRIGGER blocks_search_au AFTER UPDATE ON blocks BEGIN
  INSERT OR REPLACE INTO page_search (rowid, title, body)
  SELECT p.rowid, p.title,
    COALESCE((
      SELECT group_concat(t.text, char(8233))
      FROM (
        SELECT CASE WHEN json_valid(b.content_json) THEN CAST(json_extract(b.content_json, '$.text') AS TEXT) END AS text
        FROM blocks b
        WHERE b.page_id = p.id
          AND b.deleted_at IS NULL
          AND b.type IN ('text', 'heading', 'bulleted_list_item', 'checklist_item')
        ORDER BY b.position, b.id
      ) t
    ), '')
  FROM pages p
  WHERE p.id IN (old.page_id, new.page_id);
END;

CREATE TRIGGER blocks_search_ad AFTER DELETE ON blocks BEGIN
  INSERT OR REPLACE INTO page_search (rowid, title, body)
  SELECT p.rowid, p.title,
    COALESCE((
      SELECT group_concat(t.text, char(8233))
      FROM (
        SELECT CASE WHEN json_valid(b.content_json) THEN CAST(json_extract(b.content_json, '$.text') AS TEXT) END AS text
        FROM blocks b
        WHERE b.page_id = p.id
          AND b.deleted_at IS NULL
          AND b.type IN ('text', 'heading', 'bulleted_list_item', 'checklist_item')
        ORDER BY b.position, b.id
      ) t
    ), '')
  FROM pages p
  WHERE p.id = old.page_id;
END;
