      "type": "trigger",
      "data": {
        "on": 2,
        "references_in_body": [
          2,
          0,
          3
        ],
        "name": "pages_search_ai",
        "sql": "CREATE TRIGGER pages_search_ai AFTER INSERT ON pages BEGIN\n  INSERT OR REPLACE INTO page_search (rowid, title, body)\n  SELECT p.rowid, p.title,\n    COALESCE((\n      SELECT group_concat(t.text, char(8233))\n      FROM (\n        SELECT CASE WHEN json_valid(b.content_json) THEN CAST(json_extract(b.content_json, '$.text') AS TEXT) END AS text\n        FROM blocks b\n        WHERE b.page_id = p.id\n          AND b.deleted_at IS NULL\n          AND b.type IN ('text', 'heading', 'bulleted_list_item', 'checklist_item')\n        ORDER BY b.position, b.id\n      ) t\n    ), '')\n  FROM pages p\n  WHERE p.id = new.id;\nEND;"
      }
    },
