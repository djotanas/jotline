      "name": "blocks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"blocks\" (\"id\" TEXT NOT NULL, \"page_id\" TEXT NOT NULL REFERENCES pages (id), \"type\" TEXT NOT NULL, \"content_json\" TEXT NOT NULL, \"position\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" TEXT NOT NULL, \"updated_by\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pages_search_ai",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER pages_search_ai AFTER INSERT ON pages BEGIN INSERT OR REPLACE INTO page_search (\"rowid\", title, body) SELECT p.\"rowid\", p.title, COALESCE((SELECT group_concat(t.text, char(8233)) FROM (SELECT CASE WHEN json_valid(b.content_json) THEN CAST(json_extract(b.content_json, '$.text') AS TEXT) END AS text FROM blocks AS b WHERE b.page_id = p.id AND b.deleted_at IS NULL AND b.type IN ('text', 'heading', 'bulleted_list_item', 'checklist_item') ORDER BY b.position, b.id) AS t), '') FROM pages AS p WHERE p.id = new.id;END"
        }
      ]
    },
