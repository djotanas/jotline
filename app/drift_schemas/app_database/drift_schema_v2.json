  "fixed_sql": [
    {
      "name": "notebooks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notebooks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"cover\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"created_by\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "notebook_members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notebook_members\" (\"id\" TEXT NOT NULL, \"notebook_id\" TEXT NOT NULL REFERENCES notebooks (id), \"user_id\" TEXT NOT NULL, \"role\" TEXT NOT NULL CHECK(role IN ('owner', 'editor', 'viewer')), \"added_by\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"archived_at\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"notebook_id\", \"user_id\"));"
        }
      ]
    },
    {
      "name": "pages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pages\" (\"id\" TEXT NOT NULL, \"notebook_id\" TEXT NOT NULL REFERENCES notebooks (id), \"title\" TEXT NOT NULL, \"position\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"updated_by\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "blocks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"blocks\" (\"id\" TEXT NOT NULL, \"page_id\" TEXT NOT NULL REFERENCES pages (id), \"type\" TEXT NOT NULL, \"content_json\" TEXT NOT NULL, \"position\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" TEXT NOT NULL, \"updated_by\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_user",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_user\" (\"slot\" INTEGER NOT NULL CHECK(\"slot\" = 1), \"id\" TEXT NOT NULL, PRIMARY KEY (\"slot\"));"
        }
      ]
    },
    {
      "name": "pages_notebook_position",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX pages_notebook_position ON pages (notebook_id, position)"
        }
      ]
    },
    {
      "name": "blocks_page_position",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX blocks_page_position ON blocks (page_id, position)"
