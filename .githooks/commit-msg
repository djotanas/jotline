#!/bin/sh
set -eu

msg_file="$1"

print_help() {
  echo "Expected format: <type>[(<scope>)][!]: <description>" >&2
  echo "Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
  echo "Allowed scopes (optional): app, server, docs, infra" >&2
}

header=""
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    '#'*) continue ;;
    '') continue ;;
    *)
      header="$line"
      break
      ;;
  esac
done < "$msg_file"

if [ -z "$header" ]; then
  echo "Commit message is empty or contains only comments." >&2
  print_help
  exit 1
fi

case "$header" in
  Merge\ *) exit 0 ;;
  Revert\ \"*\") exit 0 ;;
esac

if [ "${#header}" -gt 100 ]; then
  echo "Commit header is longer than 100 characters." >&2
  print_help
  exit 1
fi

rest=$(printf '%s' "$header" | sed -E 's/^[a-zA-Z]+(\([a-zA-Z0-9_-]+\))?!?: //')
if [ "$rest" = "$header" ]; then
  echo "Commit header does not match the expected format: '$header'" >&2
  print_help
  exit 1
fi

description=$(printf '%s' "$rest" | sed -E 's/[[:space:]]+$//')
if [ -z "$description" ]; then
  echo "Commit description is empty." >&2
  print_help
  exit 1
fi

type=$(printf '%s' "$header" | sed -E 's/^([a-zA-Z]+).*/\1/')
case "$type" in
  feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert) ;;
  *)
    echo "Type '$type' is not allowed." >&2
    print_help
    exit 1
    ;;
esac

scope=$(printf '%s' "$header" | sed -E 's/^[a-zA-Z]+\(([a-zA-Z0-9_-]+)\).*/\1/; t; s/.*//')
if [ -n "$scope" ]; then
  case "$scope" in
    app|server|docs|infra) ;;
    *)
      echo "Scope '$scope' is not allowed." >&2
      print_help
      exit 1
      ;;
  esac
fi

exit 0
